# BirdBand reads plain environment variables.  It never loads a .env file, and
# it never needs one - every value below has a working default.  This file is
# documentation of the knobs, not a required step.

# Where the store, credentials and session live.
# Empty means ~/.birdband
BIRDBAND_HOME=

# Passphrase used by `birdband register` / `birdband login` when standard input
# is not a terminal (scripts, CI, the recorded demo).  Empty means the normal
# hidden getpass prompt.
BIRDBAND_PASSPHRASE=

# Set to any non-empty value to switch ANSI colour off.
NO_COLOR=

# Set to 1 to let unexpected failures raise instead of printing one line.
BIRDBAND_DEBUG=
